GPIO3.associatedPins[1].pin.$assign = "PA14";
GPIO3.associatedPins[2].$name       = "BIN2";
GPIO3.associatedPins[2].pin.$assign = "PA17";
GPIO3.associatedPins[3].$name       = "BIN1";
GPIO3.associatedPins[3].pin.$assign = "PA16";
GPIO3.associatedPins[4].$name       = "DIN2";
GPIO3.associatedPins[4].pin.$assign = "PA26";
GPIO3.associatedPins[5].$name       = "DIN1";
GPIO3.associatedPins[5].pin.$assign = "PA25";

GPIO4.$name                         = "GPIO_DIRB";
GPIO4.port                          = "PORTB";
GPIO4.associatedPins.create(2);
GPIO4.associatedPins[0].$name       = "CIN2";
GPIO4.associatedPins[0].pin.$assign = "PB24";
GPIO4.associatedPins[1].$name       = "CIN1";
GPIO4.associatedPins[1].pin.$assign = "PB20";

GPIO5.$name                              = "GPIO_IMU_B";
GPIO5.port                               = "PORTB";
GPIO5.associatedPins.create(3);
GPIO5.associatedPins[0].$name            = "MOSI";
GPIO5.associatedPins[0].pin.$assign      = "PB17";
GPIO5.associatedPins[1].$name            = "MISO";
GPIO5.associatedPins[1].direction        = "INPUT";
GPIO5.associatedPins[1].internalResistor = "PULL_DOWN";
GPIO5.associatedPins[1].pin.$assign      = "PB18";
GPIO5.associatedPins[2].initialValue     = "SET";
GPIO5.associatedPins[2].$name            = "CSB1";
GPIO5.associatedPins[2].pin.$assign      = "PB19";

GPIO6.$name                          = "GPIO_IMU_A";
GPIO6.port                           = "PORTA";
GPIO6.associatedPins.create(2);
GPIO6.associatedPins[0].$name        = "SCLK";

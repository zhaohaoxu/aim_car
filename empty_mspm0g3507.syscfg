GPIO7.$name                         = "GPIO_TRACE_B";
GPIO7.port                          = "PORTB";
GPIO7.associatedPins.create(3);
GPIO7.associatedPins[0].$name       = "AD2";
GPIO7.associatedPins[0].pin.$assign = "PB1";
